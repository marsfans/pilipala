name: Rust Multi‑Platform Build

on:
  push:
    tags: ['v*.*.*']          # 只在发布 tag 时打包 Release

jobs:
  build:
    name: Build
    strategy:
      matrix:
        include:
          # ==============================
          # 1️⃣ Linux
          # ==============================
          - { os: ubuntu-20.04, target: x86_64-unknown-linux-gnu,  buckets: ["x86_64"] }
          - { os: ubuntu-20.04, target: aarch64-unknown-linux-gnu, buckets: ["aarch64"] }
          - { os: ubuntu-20.04, target: i686-unknown-linux-gnu,   buckets: ["i386"]}

          # ==============================
          # 2️⃣ macOS
          # ==============================
          - { os: macos-12, target: x86_64-apple-darwin,    buckets: ["x86_64"] }
          - { os: macos-12, target: aarch64-apple-darwin,    buckets: ["aarch64"] }

          # ==============================
          # 3️⃣ Windows – 需要 windows‑runner 交叉构建
          # ==============================
          #   * 下面的 `windows-gnu` 在 Linux cross 能跑 (cargo‑cross)  
          #   * `msvc` 只能推到 Windows runner 里跑 (一次真正的 Windows machine)
          - { os: windows-2022, target: x86_64-pc-windows-gnu,  buckets: ["x86_64"] }
          - { os: windows-2022, target: x86_64-pc-windows-msvc, buckets: ["x86_64"] }

          # ==============================
          # 4️⃣ Android (可选)
          # ==============================
          #   * 提前在挂载 `ANDROID_HOME` 的会主机或 `cross` 能跑 Android target
          #   * `cross` 需要已安装 ndk
          # - { os: ubuntu-20.04, target: aarch64-linux-android, buckets: ["android-arm64"] }
      fail-fast: false

    runs-on: ${{ matrix.os }}

    env:
      # 对所有 platform 统一的 env，可在需要时去除或区别写
      CARGO_REGISTRIES_CRATES_IO_PROTOCOL: sparse   # 让 cargo 使用 sparse registry 省下时间 & 容量

    steps:
      # ---------- Checkout ----------
      - uses: actions/checkout@v4

      # ---------- Cache ~/.cargo, registry & tcache ----------
      - uses: actions/cache@v3
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            ~/.cargo/bin
            ~/.rustup
          key: ${{ runner.os }}-${{ matrix.target }}-cargo-${{ hashFiles('**/Cargo.toml') }}
          restore-keys: |
            ${{ runner.os }}-${{ matrix.target }}-cargo-

      # ---------- Install Rust toolchain ----------
      - name: Install Rust
        uses: actions-rs/toolchain@v1
        with:
          # 默认 `stable` 就能跑，若你需要 nightly 再改
          toolchain: stable
          target: ${{ matrix.target }}
          profile: minimal
          override: true

      # ---------- OPTIONAL: install cross (for non-windows targets) ----------
      - name: Install cross
        if: runner.os != 'Windows'
        run: cargo install cross --locked

      # ---------- Build ----------
      - name: Build (cross if possible, fallback to cargo)
        shell: bash
        run: |
          if [[ "$RUNNER_OS" == "Windows" ]]; then
            # Windows 使用 cargo 本地编译 (因为 cross 只能做 GNU 目标)
            cargo build --release --target ${{ matrix.target }}
          else
            # 在 Linux/macOS / Windows-gnu 目标中，用 cross
            cross --quiet build --release --target ${{ matrix.target }}
          fi

      # ---------- Generate asset name ----------
      - name: Set up output name
        id: outname
        shell: bash
        run: |
          BIN_NAME=${{ github.event.repository.name }}
          # windows 末尾加 .exe
          EXE_EXT=$(if [[ "$RUNNER_OS" == "Windows" ]]; then echo ".exe"; else echo ""; fi)
          FILE_NAME="${BIN_NAME}-${{ matrix.target }}${EXE_EXT}"
          echo "file=$FILE_NAME" >> "$GITHUB_OUTPUT"

      # ---------- Artifact ----------
      - name: Upload artifact
        uses: actions/upload-artifact@v3
        with:
          name: ${{ steps.outname.outputs.file }}
          path: target/${{ matrix.target }}/release/${{ github.event.repository.name }}${{ matrix.target == 'x86_64-pc-windows-gnu' && '.exe' || '' }}

  # ---------- Publish Release Assets ----------
  publish:
    name: Publish release assets
    needs: build
    runs-on: ubuntu-20.04
    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/')
    concurrency: release-${{ github.ref }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download all artifacts
        uses: actions/download-artifact@v3

      - name: Create archives (zip both native and cross)
        run: |
          mkdir dist
          for dir in */; do
            tar -czf dist/${dir%/}.tar.gz -C "$dir" .
          done

      - name: Upload Release
        uses: softprops/action-gh-release@v1
        with:
          files: dist/*.tar.gz
          tag_name: ${{ github.ref_name }}
          generate_release_notes: true
